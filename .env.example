# Copier ce fichier en .env puis adapter les valeurs.
PORT=8000
# MongoDB local (voir docker-compose.yml) ou chaîne Atlas mongodb+srv://...
MONGO_DB_URI=mongodb://127.0.0.1:27017/rylize
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=remplacer_par_un_secret_long_et_aleatoire
# development | production
NODE_ENV=development

# Service de machine learning (facultatif) : suggestion de catégorie, prévisions, anomalies
# Lancer : cd ml-service && pip install -r requirements.txt && uvicorn app.main:app --port 8001
ML_SERVICE_URL=http://127.0.0.1:8001
# Même valeur côté service ML (variable ML_SERVICE_TOKEN) ; laisser vide en développement
ML_SERVICE_TOKEN=
